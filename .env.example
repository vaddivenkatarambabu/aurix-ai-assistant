# Put your real provider key only in the ignored local .env file.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Voice interaction
AURIX_REQUIRE_WAKE_WORD=false
AURIX_WAKE_WORD=aurix
AURIX_SPEECH_LANGUAGE=en-US
AURIX_CONVERSATION_WINDOW_SECONDS=30
AURIX_TTS_ENABLED=true

# AI reliability
AURIX_MAX_HISTORY_TURNS=8
AURIX_REQUEST_TIMEOUT_SECONDS=25
AURIX_MAX_API_RETRIES=1
AURIX_LOG_LEVEL=INFO
