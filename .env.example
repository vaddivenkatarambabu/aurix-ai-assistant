# Copy this file to ".env" and fill in your own keys. ".env" is ignored by Git - never commit it.

# --- AI provider (any OpenAI-compatible API; the defaults target Groq) ---
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# --- Voice interaction ---
AURIX_REQUIRE_WAKE_WORD=false
AURIX_WAKE_WORD=aurix
AURIX_SPEECH_LANGUAGE=en-US
AURIX_CONVERSATION_WINDOW_SECONDS=30
AURIX_PHRASE_TIME_LIMIT_SECONDS=20
AURIX_PAUSE_THRESHOLD_SECONDS=0.8

# --- Spoken replies (text-to-speech) ---
AURIX_TTS_ENABLED=true
# Words per minute (default 175; try 150 for slower speech)
AURIX_TTS_RATE=175

# --- Speech recognition: google (online), whisper (local/offline) or auto ---
AURIX_STT_ENGINE=google
AURIX_WHISPER_MODEL=small
# Ask "I heard ... Should I do that?" before acting when the engine's confidence is below this
AURIX_STT_MIN_ACTION_CONFIDENCE=0.80

# --- AI reliability ---
AURIX_MAX_HISTORY_TURNS=8
AURIX_REQUEST_TIMEOUT_SECONDS=25
AURIX_MAX_API_RETRIES=1
# Reasoning models spend part of these budgets on hidden thinking
AURIX_MAX_RESPONSE_TOKENS=1200
AURIX_INTENT_MAX_TOKENS=600

# --- Market data (optional; Alpha Vantage daily end-of-day data, not a live quote) ---
ALPHA_VANTAGE_API_KEY=
AURIX_MARKET_DATA_BASE_URL=https://www.alphavantage.co/query
AURIX_MARKET_DATA_TIMEOUT_SECONDS=8
AURIX_MARKET_DATA_CACHE_TTL_SECONDS=300
AURIX_MARKET_DATA_MAX_AGE_DAYS=7
AURIX_MARKET_DATA_MAX_RETRIES=1

# --- Logging (rotating file; defaults to the "logs" folder inside the project) ---
AURIX_LOG_LEVEL=INFO
# AURIX_LOG_DIR=logs
AURIX_LOG_MAX_BYTES=1048576
AURIX_LOG_BACKUP_COUNT=3
